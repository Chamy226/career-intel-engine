      "position": [
        260,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const KEYWORDS = /data|product|analyst|automation|bangkok|thailand/i;\n\nfunction archetypeFor(title, category = '') {\n  const t = `${title} ${category}`.toLowerCase();\n  if (/product\\s*owner|product\\s*manager|\\bpm\\b/.test(t)) return 'Product';\n  if (/automat|\\bai\\b|llm|machine learning|\\bml\\b/.test(t)) return 'AI';\n  return 'Data';\n}\n\nfunction stripHtml(html) {\n  return String(html || '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst seen = new Set();\nconst out = [];\n\nfor (const item of items) {\n  const jobs = Array.isArray(item.json.jobs) ? item.json.jobs : [];\n  for (const job of jobs) {\n    const title = job.title || '';\n    const description = stripHtml(job.description);\n    const location = job.candidate_required_location || '';\n    const blob = `${title} ${description} ${location}`;\n    if (!KEYWORDS.test(blob)) continue;\n\n    const url = job.url || '';\n    if (!url || seen.has(url)) continue;\n    seen.add(url);\n\n    out.push({\n      json: {\n        title,\n        company_name: job.company_name || 'Unknown',\n        url,\n        description: description.slice(0, 8000),\n        archetype: archetypeFor(title, job.category || ''),\n        ats_system: 'Unknown',\n      },\n    });\n  }\n}\n\n// Cap per run so Groq/PDF generation stays healthy\nreturn out.slice(0, 8);"
      },
