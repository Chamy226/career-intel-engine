# Copy to .env on the VPS and fill in real values.
# NEVER commit .env. NEVER paste tokens into chat/Telegram/GitHub.

# --- Public URL (set AFTER Cloudflare Tunnel / ngrok hostname exists) ---
# Must be https:// and preferably end with /
N8N_HOST=n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/

# --- MUST match your Mac's ~/.n8n/config encryptionKey if you migrate the DB ---
# On Mac: python3 -c "import json;print(json.load(open('$HOME/.n8n/config'))['encryptionKey'])"
N8N_ENCRYPTION_KEY=REPLACE_WITH_LOCAL_ENCRYPTION_KEY

# --- Optional editor basic auth (deprecated on newest n8n; prefer owner login + Cloudflare Access) ---
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong-password

# --- Cloudflare Tunnel (only if using docker compose --profile cloudflare) ---
# Create at: https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=

# --- App secrets used inside n8n workflows (HTTP Request headers / credentials) ---
# These are NOT auto-injected into nodes; paste into n8n credentials / node headers after import.
CAREER_INTEL_API_KEY=REPLACE_WITH_VPS_OR_LOCAL_API_KEY
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
CAREER_INTEL_BASE_URL=http://host.docker.internal:8000
# On Linux Docker, prefer host-gateway (see deploy/n8n/README.md):
# CAREER_INTEL_BASE_URL=http://host.docker.internal:8000
